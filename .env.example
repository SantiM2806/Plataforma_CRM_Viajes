# ============================================================
# Travelkit CRM — variables de entorno (copiar a .env / .env.local)
# ============================================================

# --- Supabase self-hosted (instancia PROPIA de este proyecto) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-SUPABASE.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...   # SOLO server-side (worker / API routes)

# --- Postgres directo (para migraciones; usuario/credenciales independientes) ---
# Apunta al Postgres de TU Supabase self-hosted (rol dedicado 'crm')
DATABASE_URL=postgresql://crm:PASSWORD@localhost:5432/postgres

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- OAuth Google Workspace (se configura en Supabase Auth) ---
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET se cargan en el panel de Supabase.

# --- Proveedores ---
LITEAPI_KEY_SANDBOX=
LITEAPI_KEY_PROD=
LITEAPI_ENV=sandbox            # sandbox | prod

# --- TRM (BanRep) ---
# Fuente oficial vía datos.gov.co (Banco de la República). Sin API key.
TRM_SOURCE_URL=https://www.datos.gov.co/resource/32sa-8pi3.json

# --- App ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
