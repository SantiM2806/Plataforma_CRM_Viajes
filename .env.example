# ============================================================
# Travelkit CRM — variables de entorno (copiar a .env / .env.local)
# ============================================================

# --- PostgreSQL ---
# ADMIN/owner: se usa SOLO para correr migraciones (crea roles, funciones, etc.)
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@localhost:5432/travelkit_crm
# RUNTIME de la app: rol crm_app (RLS ACTIVA). Es el que usa web/worker.
DATABASE_APP_URL=postgresql://crm_app:change_me_dev@localhost:5432/travelkit_crm

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=            # genera uno:  openssl rand -base64 32
AUTH_URL=http://localhost:3000
# OAuth Google Workspace (Google Cloud Console → credenciales OAuth 2.0):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Proveedores ---
LITEAPI_KEY_SANDBOX=
LITEAPI_KEY_PROD=
LITEAPI_ENV=sandbox            # sandbox | prod

# --- TRM (BanRep, vía datos.gov.co; sin API key) ---
TRM_SOURCE_URL=https://www.datos.gov.co/resource/32sa-8pi3.json

# --- App ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
